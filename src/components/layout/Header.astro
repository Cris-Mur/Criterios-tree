---
import { Image } from "astro:assets";
import logoImage from "@assets/branding/logo.png";
import Button from "@components/ui/Button.astro";
import navDataRaw from "@data/navigation.json";
import type { NavigationData } from "@utils/schemas";
import "@styles/components/header.css";

/**
 * Componente Header
 * Navegación principal del sitio. Incluye el logo, links dinámicos y CTA de contacto.
 * Soporta estados visuales al hacer scroll mediante JavaScript.
 */

// Casteamos los datos de navegación para asegurar el tipado en el linter
const navData = navDataRaw as NavigationData;

const pathname = Astro.url.pathname;

/**
 * Verifica si una ruta es la actual para resaltar el link en la navegación.
 * @param href - Ruta a verificar.
 */
const isCurrentPage = (href: string): boolean => {
	if (href === "/" && pathname === "/") return true;
	if (href !== "/" && pathname.startsWith(href)) return true;
	return false;
};

// Obtenemos el link de WhatsApp desde la configuración de navegación
const whatsappLink = navData.socials.find((s: { id: string; url: string }) => s.id === "whatsapp")
	?.url;
---

<header class="header">
	<div class="header__container container">
		<a href="/" class="header__logo-link" aria-label="Ir al inicio">
			<Image src={logoImage} alt="Criterios Logo" width={50} height={50} class="header__logo" />
		</a>

		<nav class="header__nav" aria-label="Navegación principal">
			<ul class="header__nav-list">
				{
					navData.navigation.map(({ href, label }: { href: string; label: string }) => (
						<li>
							<a
								href={href}
								class:list={[
									"header__nav-link",
									{ "header__nav-link--active": isCurrentPage(href) }
								]}
								aria-current={isCurrentPage(href) ? "page" : undefined}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header__actions">
			<Button href={whatsappLink} variant="outline" class="header__cta" target="_blank">
				{navData.ui.header.cta}
			</Button>

			<button class="header__menu-toggle" aria-label="Abrir menú de navegación">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
</header>

<script>
	import "@scripts/layout/header";
</script>
