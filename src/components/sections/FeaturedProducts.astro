---
/**
 * Componente FeaturedProducts
 * Vitrina destacada que muestra los productos con mayor 'luxury_score'.
 * Utiliza Content Collections para filtrar y ordenar dinámicamente.
 * Cumple con el estándar de Atomic Design (Organism).
 */
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SectionContainer from "@components/layout/SectionContainer.astro";
import ProductCard from "@components/ui/ProductCard.astro";
import Button from "@components/ui/Button.astro";
import homeData from "@data/home.json";
import "@styles/components/featured-products.css";

/** Obtenemos solo los productos que no son borradores */
const allProducts: CollectionEntry<"products">[] = await getCollection(
	"products",
	({ data }) => !data.draft
);

/** Filtramos y ordenamos por Luxury Score para mostrar el "Top 3" */
const featured = [...allProducts]
	.sort((a, b) => b.data.luxury_score - a.data.luxury_score)
	.slice(0, 3);

const { overline, title, button } = homeData.featured;
---

<SectionContainer variant="stardust" class="featured-products">
	<div class="featured-products__header js-reveal">
		<p class="text-glow">{overline}</p>
		<h2 class="text-glow">{title}</h2>
	</div>

	<div class="featured-products__grid js-featured-grid">
		{
			featured.map((product) => (
				<div class="js-product-item">
					<ProductCard
						title={product.data.title}
						description={product.data.description}
						price={product.data.price}
						category={product.data.category}
						luxury_score={product.data.luxury_score}
						image={product.data.image}
						href={`/catalogo/${product.id}/`}
					/>
				</div>
			))
		}
	</div>

	<div class="featured-products__footer js-reveal">
		<Button href={button.href} variant="outline"> {button.label} </Button>
	</div>
</SectionContainer>

<script>
	import "@scripts/components/featured-products";
</script>
