---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionContainer from "@components/layout/SectionContainer.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import Button from "@components/ui/Button.astro";
import { Image } from "astro:assets";
import navDataRaw from "@data/navigation.json";
import type { NavigationData } from "@utils/schemas";
import commonUI from "@data/ui/common.json";
import "@styles/pages/product-detail.css";

const navData = navDataRaw as NavigationData;

/**
 * Genera las rutas estáticas para todos los productos de la colección.
 */
export async function getStaticPaths() {
	const excludeIds = (import.meta.env.EXCLUDE_PRODUCTS || "")
		.split(",")
		.map((id: string) => id.trim())
		.filter(Boolean);

	const products = await getCollection("products");
	const filteredProducts = products.filter((product) => !excludeIds.includes(product.id));

	return filteredProducts.map((product) => ({
		params: { id: product.id },
		props: { product }
	}));
}

/**
 * Props recibidas desde getStaticPaths.
 */
interface Props {
	product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { Content } = await render(product);

const { title, description, category, luxury_score, price, image } = product.data;
const { catalog } = commonUI;

// Procesar stock dinámicamente mediante variables de entorno
const outOfStockIds = (import.meta.env.OUT_OF_STOCK_PRODUCTS || "")
	.split(",")
	.map((id: string) => id.trim())
	.filter(Boolean);

const inStock = product.data.inStock && !outOfStockIds.includes(product.id);

// Generar mensaje dinámico para WhatsApp para facilitar la conversión directa
const whatsappMessage = encodeURIComponent(
	`Hola Criterios! Me interesa el producto: ${title}. Quisiera más información.`
);
const whatsappLink = `https://wa.me/573208722922?text=${whatsappMessage}`;
---

<BaseLayout title={title} description={description} ogImage={image.src}>
	<main>
		<!-- Cabecera estandarizada con la imagen del producto como fondo sutil -->
		<PageHeader title={title} subtitle={category} bgImage={image} />

		<SectionContainer variant="stardust" class="product-detail">
			<div class="product-detail__grid">
				<div class="product-detail__image-wrapper">
					<Image
						src={image}
						alt={title}
						width={600}
						height={600}
						class:list={[
							"product-detail__image",
							"luxury-border",
							{ "product-detail__image--out-of-stock": !inStock }
						]}
						loading="eager"
					/>
					{
						!inStock && (
							<span class="product-detail__stock-badge">{catalog.outOfStock}</span>
						)
					}
				</div>

				<div class="product-detail__info">
					<nav class="breadcrumb">
						<a href="/catalogo/">{navData.navigation.find(n => n.href === '/catalogo/')?.label || 'Catálogo'}</a> / <span>{category}</span>
					</nav>

					<h2 class="text-glow">{catalog.technicalSheet}</h2>

					<div class="product-detail__meta">
						<div class="score-badge">
							<span>{catalog.luxuryScore}: <strong>{luxury_score.toFixed(1)}</strong></span>
						</div>
						{
							price !== undefined && (
								<span class="product-detail__price">${price.toFixed(2)}</span>
							)
						}
					</div>

					<p class="product-detail__description">
						{description}
					</p>

					<div class="product-detail__body">
						<Content />
					</div>

					<div class="product-detail__actions">
						{
							inStock ? (
								<Button href={whatsappLink} variant="solid" target="_blank">
									{catalog.whatsappCTA}
								</Button>
							) : (
								<Button disabled class="btn--disabled" variant="solid">
									{catalog.temporarilyOutOfStock}
								</Button>
							)
						}
						<Button href="/catalogo/" variant="outline"> {catalog.back} </Button>
					</div>
				</div>
			</div>
		</SectionContainer>
	</main>
</BaseLayout>
