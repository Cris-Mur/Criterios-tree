---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionContainer from "@components/layout/SectionContainer.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import Button from "@components/ui/Button.astro";
import stores from "@data/stores.json";
import siteData from "@data/site.json";
import storesUI from "@data/ui/stores.json";
import bgStores from "@assets/gallery/9.webp";
import "@styles/pages/stores.css";

const { title, description } = siteData.seo.tiendas;
const { labels } = storesUI;
---

<BaseLayout title={title} description={description}>
	<main>
		<PageHeader
			title={title.split(" | ")[0]}
			subtitle={`${siteData.global.siteName} en tu Ciudad`}
			bgImage={bgStores}
		/>

		<SectionContainer variant="stardust">
			<div class="stores-grid">
				{
					stores.map((store) => (
						<article class="store-card luxury-border js-reveal">
							<header class="store-card__header">
								<span class="store-card__badge">
									{store.isDigital ? labels.digital : labels.physical}
								</span>
								<h2 class="text-glow">{store.name}</h2>
							</header>

							<ul class="store-card__details">
								<li>
									<span>{labels.location}</span>
									<span>{store.address}</span>
								</li>
								<li>
									<span>{labels.hours}</span>
									<span>{store.hours}</span>
								</li>
								<li>
									<span>{labels.contact}</span>
									<span>{store.phone}</span>
								</li>
							</ul>

							<div class="store-card__actions">
								<Button
									href={store.mapLink}
									variant={store.isDigital ? "solid" : "outline"}
									target="_blank"
									class="store-card__btn"
								>
									{store.isDigital ? labels.ctaDigital : labels.ctaPhysical}
								</Button>
							</div>
						</article>
					))
				}
			</div>
		</SectionContainer>
	</main>
</BaseLayout>

<script>
	import "@scripts/animations";
</script>
