---
/**
 * 🌌 Página de Agradecimiento
 * Branded thank-you page displayed after submitting any experience form.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import "@styles/pages/feedback.css";

const title = "Muchas Gracias";
const description = "Agradecemos tu valiosa retroalimentación para seguir perfeccionando Criterios.";
---

<BaseLayout title={title} description={description}>
	<main class="feedback-container js-reveal" style="text-align: center; margin: calc(var(--space-xl) * 1.5) auto;">
		<header class="feedback-header">
			<h1 class="feedback-title text-glow">¡Muchas Gracias!</h1>
			<p class="feedback-subtitle" style="font-size: 1.15rem; margin-top: 1rem;">
				Tu auditoría y comentarios han sido registrados con éxito. Cada detalle nos ayuda a elevar el estándar artesanal de nuestras creaciones.
			</p>
		</header>

		<section class="feedback-card" style="margin-top: var(--space-md);">
			<p style="color: rgba(255, 255, 255, 0.7); margin-bottom: var(--space-md);">
				¿Deseas volver a explorar nuestra exquisita selección o conocer más sobre nuestra historia?
			</p>
			
			<div style="display: flex; gap: var(--space-sm); justify-content: center; flex-wrap: wrap;">
				<a href="/" class="submit-btn" style="text-decoration: none; display: inline-block; margin-top: 0; padding: 10px 20px; font-size: 0.85rem;">
					Inicio
				</a>
				<a href="/catalogo/" class="submit-btn" style="text-decoration: none; display: inline-block; margin-top: 0; padding: 10px 20px; font-size: 0.85rem; background: rgba(255, 255, 255, 0.05); color: var(--color-gold); border-color: rgba(212, 175, 55, 0.3);">
					Catálogo
				</a>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	// Trigger animations if present
	import { animations } from "@utils/animations";
	if (animations && typeof animations.reveal === "function") {
		animations.reveal(".js-reveal", { stagger: 0.2 });
	}
</script>
