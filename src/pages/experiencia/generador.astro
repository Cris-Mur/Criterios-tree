---
/**
 * 🌌 Panel Interno de Enlaces - Generador Sensorial
 * Dashboard for internal factory tracking. Generates tracking links
 * and persists metadata in localStorage.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import commonUI from "@data/ui/common.json";
import "@styles/pages/feedback.css";

// Page metadata
const title = "Generador de Enlaces Sensoriales";
const description = "Panel de control interno para la generación y seguimiento de códigos de trazabilidad sensorial.";
const { admin } = commonUI;
---

<BaseLayout title={title} description={description}>
	<main class="admin-container js-reveal">
		<header class="feedback-header">
			<h1 class="feedback-title text-glow">{admin.title}</h1>
			<p class="feedback-subtitle">
				{admin.subtitle}
			</p>
		</header>

		{/* Generation Section */}
		<section class="feedback-card generator-section">
			<h2 class="form-label" style="font-size: 1.2rem; margin-bottom: var(--space-sm);">{admin.generatorTitle}</h2>
			<div class="feedback-form">
				<div class="generator-row">
					<div class="form-group">
						<label for="lot-input" class="form-label">{admin.lotLabel}</label>
						<input
							type="text"
							id="lot-input"
							class="form-input"
							placeholder={admin.lotPlaceholder}
							maxlength="80"
						/>
					</div>
					<button type="button" id="generate-btn" class="generate-btn">
						{admin.generateBtn}
					</button>
				</div>

				{/* Link Result Area (hidden by default, shown via JS) */}
				<div id="results-area" style="display: none; margin-top: var(--space-md); border-top: 1px solid rgba(212, 175, 55, 0.1); padding-top: var(--space-md);">
					<h3 class="form-label" style="color: var(--color-gold); font-size: 1rem; margin-bottom: var(--space-xs);">{admin.linksGeneratedFor} <span id="active-descriptor" style="color: #fff; text-transform: none;"></span></h3>
					
					<div class="generated-links-container">
						{/* Product Audit Link */}
						<div class="form-group">
							<label for="link-producto" class="form-label" style="font-size: 0.8rem;">{admin.labelProdLink}</label>
							<div class="link-box-wrapper">
								<input type="text" id="link-producto" class="form-input" readonly style="font-size: 0.85rem;" />
								<button type="button" class="copy-btn" data-target="link-producto">{admin.copyBtn}</button>
							</div>
						</div>

						{/* Client Experience Link */}
						<div class="form-group">
							<label for="link-cliente" class="form-label" style="font-size: 0.8rem;">{admin.labelClientLink}</label>
							<div class="link-box-wrapper">
								<input type="text" id="link-cliente" class="form-input" readonly style="font-size: 0.85rem;" />
								<button type="button" class="copy-btn" data-target="link-cliente">{admin.copyBtn}</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{/* History Table Section */}
		<section class="feedback-card history-section">
			<div class="history-header">
				<h2 class="history-title">{admin.historyTitle}</h2>
				<button type="button" id="clear-all-btn" class="delete-btn" style="display: none;">{admin.clearAllBtn}</button>
			</div>

			<div class="history-table-container">
				<table class="history-table">
					<thead>
						<tr>
							<th>{admin.thCode}</th>
							<th>{admin.thDescriptor}</th>
							<th>{admin.thDate}</th>
							<th>{admin.thLinks}</th>
							<th>{admin.thActions}</th>
						</tr>
					</thead>
					<tbody id="history-tbody">
						{/* Injected dynamically by client JS */}
					</tbody>
				</table>
				<div id="no-history" class="no-history-msg">
					{admin.noHistoryMsg}
				</div>
			</div>
		</section>
	</main>

	{/* Inyectamos los textos para uso en el script del cliente */}
	<script type="application/json" id="admin-ui-data" set:html={JSON.stringify(admin)}></script>
</BaseLayout>

<script>
	import "@scripts/pages/generator";
	
	// Trigger animations if present
	import { animations } from "@utils/animations";
	if (animations && typeof animations.reveal === "function") {
		animations.reveal(".js-reveal", { stagger: 0.2 });
	}
</script>
