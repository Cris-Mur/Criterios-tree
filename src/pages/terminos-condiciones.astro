---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionContainer from "@components/layout/SectionContainer.astro";
import legalData from "@data/legal.json";
import "@styles/pages/feedback.css";

/**
 * Página de Términos y Condiciones
 * Centraliza la política de privacidad y tratamiento de datos para el sistema de feedback sensorial.
 * Utiliza Data Binding desde src/data/legal.json para facilitar el mantenimiento.
 */
const { title, description, lastUpdate, sections, actions } = legalData;
---

<BaseLayout title={`${title} | Criterios`} description={description}>
	<main>
		<SectionContainer variant="stardust" class="terms-page">
			<article class="feedback-card" style="max-width: 800px; margin: 40px auto; padding: 40px;">
				<header>
					<h1 class="feedback-title text-glow" style="text-align: left; margin-bottom: 20px; font-size: 2rem;">
						{title}
					</h1>
					<p class="feedback-subtitle" style="text-align: left; margin-bottom: 30px;">
						Última actualización: {lastUpdate}.
					</p>
				</header>
				
				<div class="terms-content" style="color: rgba(255, 255, 255, 0.8); line-height: 1.7; font-size: 0.95rem; display: flex; flex-direction: column; gap: 20px;">
					{
						sections.map((section) => (
							<section>
								<h2 style="color: var(--color-gold); font-family: var(--font-heading); font-size: 1.2rem; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;">
									{section.id}. {section.title}
								</h2>
								<p set:html={section.content} />
								{section.items && (
									<ul style="padding-left: 20px; margin-top: 10px; display: flex; flex-direction: column; gap: 5px; list-style-type: circle;">
										{section.items.map((item) => (
											<li set:html={item} />
										))}
									</ul>
								)}
							</section>
						))
					}
				</div>
				
				<footer style="margin-top: 40px; border-top: 1px solid rgba(212, 175, 55, 0.1); padding-top: 20px;">
					<p style="color: var(--color-gold); font-size: 1rem; margin-bottom: 20px; font-weight: 500;">
						{actions.message}
					</p>
					<div style="display: flex; justify-content: flex-start; gap: var(--space-sm); flex-wrap: wrap;">
						{
							actions.links.map((link) => {
								// Encode static CID to Base64 to match the system's logic
								const encodedCid = Buffer.from(link.cid).toString('base64');
								const finalHref = `${link.href}?cid=${encodedCid}`;
								
								return (
									<a 
										href={finalHref} 
										class="submit-btn" 
										style={`text-decoration: none; padding: 10px 24px; font-size: 0.85rem; ${link.variant === 'secondary' ? 'background: rgba(255,255,255,0.05); color: var(--color-gold); border-color: rgba(212, 175, 55, 0.3);' : ''}`}
									>
										{link.label}
									</a>
								);
							})
						}
					</div>
				</footer>
			</article>
		</SectionContainer>
	</main>
</BaseLayout>
