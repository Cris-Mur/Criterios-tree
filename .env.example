# Configuración de Canales de Venta
PUBLIC_WHATSAPP_PHONE=tu_numero_aqui_sin_mas

# Gestión de Catálogo Dinámico
# Estas variables permiten controlar la visibilidad y disponibilidad sin tocar el código.
# Usa los IDs de los archivos .md en src/content/products (ej: 'aceite-oliva').

# IDs de productos a OCULTAR completamente del catálogo (separados por coma)
# Ejemplo: EXCLUDE_PRODUCTS=weedchocos,postre-ancestral
EXCLUDE_PRODUCTS=

# IDs de productos a marcar como AGOTADOS (separados por coma)
# Estos seguirán siendo visibles pero no permitirán el pedido directo.
# Ejemplo: OUT_OF_STOCK_PRODUCTS=miel-ancestral,tortilu
OUT_OF_STOCK_PRODUCTS=
